{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "types": ["node", "multer"],
    // rootDir moves the default .tsbuildinfo to the repo root, where it survives
    // `rm -rf dist` and makes an incremental rebuild silently emit nothing.
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },
  "exclude": ["node_modules", "dist", "scripts", "**/*spec.ts"]
}
