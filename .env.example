# Database (local or managed — free tier available on https://aiven.io)
DATABASE_URL=postgresql://user:password@localhost:5432/psg_inventory

# Auth
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES=1d

# Football Data API (https://www.football-data.org)
FOOTBALL_DATA_API_KEY=your_api_key_here

# Redis (local or managed — free tier available on https://render.com)
# Use rediss:// for TLS connections (e.g. Render)
REDIS_URL=redis://localhost:6379

# Server (optional, defaults to 7777)
PORT=7777

# Allowed frontend origins for CORS (comma-separated; defaults to http://localhost:5173)
FRONTEND_ORIGIN=http://localhost:5173

# Telemetry (optional — sign up at https://observe.nestjs.com to get these).
# Leave both unset to run with instrumentation off.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# Google Gemini API key for the /ask endpoint (optional — the app boots and
# every other route works without it; only POST /ask itself fails until a
# real key is set). The placeholder below passes env validation as-is, since
# the key is now optional rather than checked at boot, so /ask will 502 until
# you replace it with a real key.
# Free key, no credit card required: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# Max /ask questions per user per hour (optional, defaults to 20).
# The free tier quota is shared across all users of this deployment, so this
# cap protects the whole allowance, not just one user's spend.
ASK_RATE_LIMIT_PER_HOUR=20
