{
  "name": "psg_inventory",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "license": "UNLICENSED",
  "prisma": {
    "schema": "src/prisma/schema.prisma"
  },
  "scripts": {
    "build": "nest build && tsc-alias --resolve-full-paths",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" --fix",
    "lint:deps": "depcruise src --config",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "npm run build && nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "node --inspect-brk node_modules/.bin/vitest run --reporter=verbose",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "local:db:up": "docker compose up -d --wait",
    "local:db:down": "docker compose down",
    "local:db:destroy": "docker compose down -v --remove-orphans",
    "local:db:migrate": "prisma migrate deploy",
    "local:db:seed": "node --env-file-if-exists=.env node_modules/.bin/tsx scripts/seed-demo.ts",
    "local:db:seed:e2e": "node --env-file-if-exists=.env node_modules/.bin/tsx scripts/seed-e2e.ts",
    "ungift": "npx tsx scripts/ungift-sale.ts"
  },
  "dependencies": {
    "@google/genai": "2.19.0",
    "@nestjs/common": "12.6.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.6.0",
    "@nestjs/jwt": "12.0.5",
    "@nestjs/observe": "0.3.27",
    "@nestjs/passport": "12.0.2",
    "@nestjs/platform-express": "12.6.0",
    "@nestjs/schedule": "12.0.4",
    "@nestjs/swagger": "12.1.2",
    "@prisma/client": "6.0.1",
    "@types/redis": "4.0.11",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "date-fns": "4.4.0",
    "helmet": "8.3.0",
    "nestjs-pino": "5.3.2",
    "papaparse": "5.7.1",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prisma": "6.0.1",
    "qs": "6.17.1",
    "radash": "12.1.1",
    "redis": "4.7.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "9.17.0",
    "@nestjs/cli": "12.0.15",
    "@nestjs/schematics": "12.0.16",
    "@nestjs/testing": "12.6.0",
    "@swc/core": "1.16.22",
    "@types/bcrypt": "6.0.0",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.6",
    "@types/papaparse": "5.5.2",
    "@types/passport-jwt": "4.0.1",
    "@types/passport-local": "1.0.38",
    "@vitest/coverage-v8": "5.1.1",
    "dependency-cruiser": "17.4.3",
    "eslint": "9.17.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "15.13.0",
    "husky": "9.1.7",
    "lint-staged": "15.2.11",
    "pino-pretty": "13.2.0",
    "prettier": "3.10.1",
    "ts-node": "10.9.2",
    "tsc-alias": "1.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "unplugin-swc": "1.6.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vitest-mock-extended": "5.1.1"
  },
  "overrides": {
    "brace-expansion@1": "1.1.21"
  }
}
