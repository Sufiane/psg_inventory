{
  "name": "psg_inventory",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "license": "UNLICENSED",
  "prisma": {
    "schema": "src/prisma/schema.prisma"
  },
  "scripts": {
    "build": "nest build && tsc-alias --resolve-full-paths",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" --fix",
    "lint:deps": "depcruise src --config",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "npm run build && nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "node --inspect-brk node_modules/.bin/vitest run --reporter=verbose",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "local:db:up": "docker compose up -d --wait",
    "local:db:down": "docker compose down",
    "local:db:destroy": "docker compose down -v --remove-orphans",
    "local:db:migrate": "prisma migrate deploy",
    "local:db:seed": "node --env-file-if-exists=.env node_modules/.bin/tsx scripts/seed-demo.ts",
    "ungift": "npx tsx scripts/ungift-sale.ts"
  },
  "dependencies": {
    "@google/genai": "2.19.0",
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "11.2.1",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/observe": "0.2.3",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "11.4.7",
    "@prisma/client": "6.0.1",
    "@types/redis": "4.0.11",
    "bcrypt": "5.1.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "date-fns": "4.1.0",
    "helmet": "8.2.0",
    "nestjs-pino": "5.2.0",
    "papaparse": "5.5.4",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "prisma": "6.0.1",
    "qs": "6.13.1",
    "radash": "12.1.0",
    "redis": "4.7.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@eslint/js": "9.17.0",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.1",
    "@swc/core": "1.16.2",
    "@types/bcrypt": "5.0.2",
    "@types/multer": "2.2.0",
    "@types/node": "22.9.0",
    "@types/papaparse": "5.5.2",
    "@types/passport-jwt": "4.0.1",
    "@types/passport-local": "1.0.38",
    "@vitest/coverage-v8": "5.0.0",
    "dependency-cruiser": "17.4.3",
    "eslint": "9.17.0",
    "globals": "15.13.0",
    "husky": "9.1.7",
    "lint-staged": "15.2.11",
    "pino-pretty": "13.1.3",
    "prettier": "3.3.3",
    "ts-node": "10.9.2",
    "tsc-alias": "1.9.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "unplugin-swc": "1.6.0",
    "vite": "6.4.0",
    "vitest": "5.0.0",
    "vitest-mock-extended": "5.1.1"
  }
}
