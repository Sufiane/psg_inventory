    "eslint": "9.39.5",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "15.13.0",
    "sharp": "0.35.5",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "svelte-eslint-parser": "1.11.0",
    "tailwindcss": "4.3.5",
    "tslib": "2.9.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
